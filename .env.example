# Untuk pengembangan/testing lokal saja.
# Di Vercel, variabel ini otomatis diisi saat kamu menyambungkan
# database Redis (lihat README.md, bagian "Deploy ke Vercel").
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Untuk fitur "Arsip Materi Seminar" (/materi) yang terhubung ke Google Drive.
# Lihat README.md, bagian "Setup fitur Arsip Materi Seminar (Google Drive)".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# String acak panjang untuk mengenkripsi token Drive di cookie. Contoh membuat: openssl rand -hex 32
SESSION_SECRET=
